// South Urban admin — content store.
//
// The public site's copy originally lived in `data/site.ts`. That file is still
// the source of the *defaults*: `lib/content.ts` reads a row here and falls back
// to the static export when the row is missing, so the site renders correctly
// against an empty database and `npm run seed` is an import rather than a
// prerequisite.
//
// Singleton blocks (hero, vision, mission, contact…) live in `Section.data` as
// JSON, described by the field schemas in `lib/content-schema.ts`. The five
// collections editors add to and reorder day to day get real tables so they can
// be paged, sorted and published independently.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of the schema: migrations read it from
// `prisma.config.ts`, and the client gets it through a driver adapter in lib/db.ts.
datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("editor") // "admin" grants user management
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@map("admin_users")
}

/// One row per singleton content block, keyed by the ids in `SECTION_SCHEMAS`.
model Section {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("sections")
}

model Person {
  id            String  @id @default(cuid())
  group         String // "board" | "management"
  name          String
  role          String
  photo         String?
  /// Tailwind object-position utility, e.g. "object-[center_30%]"
  photoPosition String?
  teaser        String
  bio           String  @db.Text
  order         Int     @default(0)
  published     Boolean @default(true)

  @@index([group, order])
  @@map("people")
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  readTime    String
  image       String?
  date        DateTime
  category    String
  author      String
  /// PostBlock[] — see `PostBlock` in data/site.ts
  body        Json
  published   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([published, date])
  @@map("posts")
}

model Service {
  id        String  @id @default(cuid())
  title     String
  summary   String  @db.Text
  body      String  @db.Text
  order     Int     @default(0)
  published Boolean @default(true)

  @@index([order])
  @@map("services")
}

model Notification {
  id          String  @id @default(cuid())
  title       String  @db.Text
  summary     String  @db.Text
  /// Display string as shown in the ticker, e.g. "07.08.2026 04:37 PM"
  date        String
  category    String
  hasDownload Boolean @default(false)
  order       Int     @default(0)
  published   Boolean @default(true)

  @@index([order])
  @@map("notifications")
}

model GalleryItem {
  id        String  @id @default(cuid())
  src       String
  alt       String
  category  String
  order     Int     @default(0)
  published Boolean @default(true)

  @@index([order])
  @@map("gallery_items")
}

/// Every upload, so the media library can list what exists and the admin can
/// warn when an image no longer matches the spec of the slot it is used in.
model MediaAsset {
  id          String   @id @default(cuid())
  url         String   @unique
  pathname    String
  filename    String
  contentType String
  size        Int
  width       Int
  height      Int
  /// Key from `IMAGE_SPECS` this was uploaded against, when known.
  slot        String?
  alt         String?
  createdAt   DateTime @default(now())
  uploadedBy  String?

  @@index([slot, createdAt])
  @@map("media_assets")
}
