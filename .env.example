# Copy to .env.local and fill in. Never commit the filled-in file.

# Postgres. Vercel Postgres, Neon and Supabase all give you a URL in this shape.
# Prisma reads it for migrations (prisma.config.ts) and at runtime (lib/db.ts).
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# Vercel Blob, for image uploads. Create a Blob store in the Vercel dashboard
# and copy its read/write token. Without this, the admin loads but uploading an
# image returns a clear "not configured" error.
BLOB_READ_WRITE_TOKEN=""

# Optional. Caps the Postgres connection pool. Leave unset for a hosted
# database; set to 1 when using the local PGlite server (`npm run db:local`),
# which accepts a single connection at a time.
DATABASE_POOL_MAX=""
